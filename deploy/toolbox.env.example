TOOLBOX_TITLE=Įrankinė
TOOLBOX_DATA=/var/lib/toolbox
# Serveris: 2 branduoliai, 4 GB RAM -> skaičiuojama po vieną užduotį, ji gauna visą atmintį
TOOLBOX_WORKERS=1
TOOLBOX_JOB_TTL_H=72
# Vienos užduoties laiko limitas, min.
TOOLBOX_JOB_TIMEOUT_MIN=30
TOOLBOX_MAX_UPLOAD_MB=500
# Atminties ribos vienai užduočiai (TIN ~1 GB / 1 mln. taškų)
TOOLBOX_MAX_TIN_POINTS=2500000
TOOLBOX_MAX_CLOUD_POINTS=40000000
TOOLBOX_LINKS=/var/lib/toolbox/links.json
# Slaptažodis (rekomenduojama, nes serveris viešas). Ištrinkite # ir įrašykite savo.
#TOOLBOX_USER=mantas
#TOOLBOX_PASS=pakeisti
